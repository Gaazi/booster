{
  "name": "booster-node",
  "version": "1.0.1",
  "description": "Zero-dependency ultra-fast caching, minification, and compression booster for Express, Next.js, Fastify, and Node.js.",
  "main": "dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "booster-node": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "default": "./dist/cache.js"
    },
    "./compressor": {
      "types": "./dist/compressor.d.ts",
      "default": "./dist/compressor.js"
    },
    "./minifier": {
      "types": "./dist/minifier.d.ts",
      "default": "./dist/minifier.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],

  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:types": "tsc --noEmit --strict --target ES2022 --module NodeNext --moduleResolution NodeNext test/package-types.ts",
    "prepack": "npm run build",
    "test": "node --test test/test-ts.ts",
    "test:ts": "node --test test/test-ts.ts",
    "start": "node dist/index.js"
  },

  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3"
  },

  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaazi/booster.git",
    "directory": "booster-node"
  },
  "keywords": [
    "booster",
    "speed",
    "cache",
    "lru-cache",
    "compression",
    "brotli",
    "gzip",
    "express",
    "nextjs",
    "fastify",
    "performance",
    "cdn",
    "cloudflare",
    "minifier"
  ],
  "author": "Ubaidullah Ghazi",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Gaazi/booster/issues"
  },
  "homepage": "https://github.com/Gaazi/booster#readme"
}
